# ==============================================================================
# Lyftr AI LLM Gateway - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and configure your values.
# Real keys MUST NEVER be committed to Git.

# --- Backend Configuration ---
# Comma-separated LLM API Key pool (at least 2 keys required for failover)
# For Groq: provide at least 2 Groq API keys (e.g. gsk_key1,gsk_key2)
LLM_API_KEYS=your_first_groq_api_key_here,your_second_groq_api_key_here

# Target LLM model supported by LiteLLM:
# For Groq, use any Groq model with "groq/" prefix, e.g.:
# - groq/llama-3.3-70b-versatile (Recommended fast & smart)
# - groq/llama-3.1-8b-instant (Super fast)
# - groq/mixtral-8x7b-32768
LLM_MODEL=groq/llama-3.3-70b-versatile

# SQLite Database URL. In Docker, maps to the mounted named volume at /data/app.db
# Locally outside Docker: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Enable Failover Test Hook (POST /chat X-Simulate-Failure header)
# Must be set to true on deployed backend for assignment grading
ENABLE_FAILURE_SIMULATION=true

# Default System Prompt (Optional)
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# --- Frontend Configuration ---
# Base URL of the backend API
VITE_API_URL=http://localhost:8000
